# Firebase web API key (public identifier, but kept out of git so the rotated/
# restricted key isn't committed). Copy this file to .env and fill in the value.
VITE_FIREBASE_API_KEY=your-rotated-firebase-api-key

# Optional, dev only: a fixed App Check debug token for `npm run dev` (register it in
# the Firebase console under App Check -> Apps -> Manage debug tokens). Never used
# in production builds.
# VITE_APPCHECK_DEBUG_TOKEN=
